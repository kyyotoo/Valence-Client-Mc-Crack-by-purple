{
	"schemaVersion": 1,
	"id": "valence",
	"version": "1.9.2",
	"name": "Valence",
	"description": "More than just a mod. 25 animated skies, Spotify lyrics in the sky, floating or on screen, and PvP styles.",
	"authors": [
		"Valence"
	],
	"license": "All-Rights-Reserved",
	"icon": "assets/valence/icon.png",
	"environment": "client",
	"entrypoints": {
